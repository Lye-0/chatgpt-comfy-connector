{
  "manifest_version": 3,
  "name": "ChatGPT Comfy Connector",
  "version": "0.2.0",
  "description": "Connects the ChatGPT Comfy Connector browser surface to its local Desktop Bridge.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43127/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Comfy Connector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "110"
}
