<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ChatGPTComfyConnector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ChatGPT Comfy Connector"
        Width="1680"
        Height="1040"
        MinWidth="1180"
        MinHeight="760"
        Language="ja-JP"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="SlotEditorTemplate">
            <Border x:Name="SlotChrome"
                    Background="{StaticResource PanelSoftBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="196" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PriorityLabel}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Address}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Address}" />
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Margin="16,0,16,0">
                        <TextBox x:Name="ValueEditor"
                                 Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Workflow slotの値。変更はUNSAVED CHANGESとして扱われます。" />
                        <ComboBox x:Name="ChoiceEditor"
                                  ItemsSource="{Binding Choices}"
                                  Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Visibility="Collapsed"
                                  ToolTip="候補から選択、または値を入力" />
                    </Grid>
                    <StackPanel Grid.Column="2"
                                Width="74"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Type}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="要確認"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding PairingSuspect, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasChoices}" Value="True">
                    <Setter TargetName="ValueEditor" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ChoiceEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PairingSuspect}" Value="True">
                    <Setter TargetName="SlotChrome" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="IterationTemplate">
            <Border Background="{StaticResource PanelSoftBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number, StringFormat=ITERATION {0}}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="10"
                               VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1"
                                Margin="10,0,8,0">
                        <TextBlock Text="{Binding Prompt}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="218" />
                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Status}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="10"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PipelineStageTemplate">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border x:Name="PipelineChrome"
                        Width="86"
                        MinHeight="54"
                        Background="#101827"
                        BorderBrush="{Binding State, Converter={StaticResource StateToBrush}}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="7,6"
                        AutomationProperties.Name="{Binding Label}">
                    <StackPanel>
                        <TextBlock Text="{Binding Key}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StateLabel}"
                                   FontSize="9"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="→"
                           Foreground="{StaticResource LineStrongBrush}"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="5,0"
                           Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="NOW">
                    <Setter TargetName="PipelineChrome" Property="Background" Value="#173B4A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="DONE">
                    <Setter TargetName="PipelineChrome" Property="Background" Value="#122A2B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="COMPLETE">
                    <Setter TargetName="PipelineChrome" Property="Background" Value="#1B3527" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ERROR">
                    <Setter TargetName="PipelineChrome" Property="Background" Value="#3A1E2A" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="98" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="16"
                Padding="14,12"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="COMFY / CHATGPT"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Connector"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#0A111D"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,7"
                        Margin="10,0,14,0"
                        AutomationProperties.Name="SYSTEM CONNECTION">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="SYSTEM CONNECTION"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SystemConnectionSummary}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <Grid Grid.Row="1"
                              Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        AutomationProperties.Name="Connector">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding ConnectorSystemState, Converter={StaticResource StateToBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock Text="Connector"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ConnectorSystemState}"
                                               Foreground="{Binding ConnectorSystemState, Converter={StaticResource StateToBrush}}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Height="1"
                                    Margin="9,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource LineStrongBrush}"
                                    ToolTip="ConnectorからMCPへ" >
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSystemProcessing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.25"
                                                                             To="1"
                                                                             Duration="0:0:1.15"
                                                                             AutoReverse="True"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        AutomationProperties.Name="MCP">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding McpSystemState, Converter={StaticResource StateToBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock Text="MCP"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding McpSystemState}"
                                               Foreground="{Binding McpSystemState, Converter={StaticResource StateToBrush}}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="3"
                                    Height="1"
                                    Margin="9,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource LineStrongBrush}"
                                    Opacity="0.55" />
                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        AutomationProperties.Name="ComfyUI">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding ComfyUiSystemState, Converter={StaticResource StateToBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock Text="ComfyUI"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ComfyUiSystemState}"
                                               Foreground="{Binding ComfyUiSystemState, Converter={StaticResource StateToBrush}}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="5"
                                    Height="1"
                                    Margin="9,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource LineStrongBrush}"
                                    Opacity="0.55" />
                            <StackPanel Grid.Column="6"
                                        Orientation="Horizontal"
                                        AutomationProperties.Name="GPU">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding GpuSystemState, Converter={StaticResource StateToBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock Text="GPU"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GpuSystemState}"
                                               Foreground="{Binding GpuSystemState, Converter={StaticResource StateToBrush}}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2"
                              Margin="0,5,0,0">
                            <TextBlock Text="制作ワークスペース"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="9" />
                            <TextBlock Text="{Binding SelectedWorkflowText}"
                                       Foreground="{StaticResource WarmBrush}"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="SETUP"
                            ToolTip="接続先とPortableパスを設定"
                            Click="Setup_Click" />
                    <Button Content="CONNECT"
                            ToolTip="comfy-mcpへ接続"
                            Click="Connect_Click" />
                    <Button Content="START COMFYUI"
                            ToolTip="ComfyUIを起動（Connectorは終了させません）"
                            Click="StartComfy_Click"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="406" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="14"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,12">
                        <TextBlock Text="WORKFLOW LIBRARY"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="制作フローを選択"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="REFRESH"
                                    ToolTip="Workflow一覧を再読み込み"
                                    Click="Refresh_Click" />
                            <Button Grid.Column="1"
                                    Content="フォルダ"
                                    ToolTip="Workflowフォルダを開く"
                                    Click="OpenWorkflowFolder_Click"
                                    Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#0A101C"
                            CornerRadius="10"
                            Padding="7"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TreeView ItemsSource="{Binding TreeNodes}"
                                          SelectedItemChanged="WorkflowTree_SelectedItemChanged">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="2,3"
                                                       TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.Name="{Binding Name}"
                                                       ToolTip="{Binding RelativePath}" />
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasTreeNodes, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="Workflowがありません"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="SetupのパスとREFRESHを確認してください"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextAlignment="Center"
                                           Margin="8,5,8,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelSoftBrush}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,12,0,0"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="選択中のWorkflow"
                                       FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkflowText}"
                                       Foreground="{StaticResource WarmBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="38"
                                       Margin="0,4,0,3" />
                            <TextBlock Text="{Binding WorkflowSlotSummaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="Workflow操作"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" />
                            <TextBox x:Name="WorkflowNameBox"
                                     ToolTip="拡張子を除いた新しいWorkflow名"
                                     Margin="0,4,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="複製"
                                        ToolTip="選択中Workflowを複製"
                                        Click="Duplicate_Click" />
                                <Button Grid.Column="1"
                                        Content="名前変更"
                                        ToolTip="選択中Workflowの名前を変更"
                                        Click="Rename_Click"
                                        Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="18"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Background="#0D1725"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                AutomationProperties.Name="CREATION PIPELINE">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CREATION PIPELINE"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="制作進行を一つのループとして確認"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrentIterationLabel}"
                                                   Foreground="{StaticResource WarmBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding PipelineLoopText}"
                                                   Foreground="{Binding CurrentCreationStageState, Converter={StaticResource StateToBrush}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding PipelineStages}"
                                                  ItemTemplate="{StaticResource PipelineStageTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{Binding CurrentCreationStageState, Converter={StaticResource StateToBrush}}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentCreationStageText}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CurrentCreationStageDescription}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#101C2C"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="制作ステージ"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="制作キャンバス"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,2" />
                                    <TextBlock Text="現在のWorkflowで、次の1件を制作します。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Border Background="#162A3A"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9,5"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding JobStatusText}"
                                                   Foreground="{StaticResource AccentStrongBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding JobStatusDetailText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedWorkflowName}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedWorkflowText}"
                                           Foreground="{StaticResource WarmBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding WorkflowSlotSummaryText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right">
                                <Button Content="SAVE + VALIDATE"
                                        ToolTip="変更を保存してWorkflowをvalidate"
                                        Click="Save_Click"
                                        IsEnabled="{Binding CanRunWorkflow}" />
                                <Button Content="VALIDATE"
                                        ToolTip="現在のWorkflowをvalidate"
                                        Click="Validate_Click"
                                        IsEnabled="{Binding CanRunWorkflow}" />
                                <Button Content="GENERATE"
                                        ToolTip="validate後に1件のJobを生成"
                                        Background="{StaticResource WarmBrush}"
                                        Foreground="#21151A"
                                        FontWeight="SemiBold"
                                        Click="Generate_Click"
                                        IsEnabled="{Binding CanRunWorkflow}"
                                        Margin="0" />
                            </WrapPanel>
                        </Grid>

                        <Border Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowWorkflowEmptyState, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Workflowを選択してください"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="左のWorkflow Libraryから制作に使うフローを選ぶと、主要設定と生成導線がここに表示されます。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,12" />
                                <Button Content="REFRESH LIBRARY"
                                        Click="Refresh_Click"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Background="#261C25"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowDisconnectedState, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="MCP未接続"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Workflowは選択されています。slotを読み込み、生成を開始するにはMCPへ接続してください。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="CONNECT"
                                            Click="Connect_Click"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="#071117" />
                                    <Button Content="START COMFYUI"
                                            Click="StartComfy_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowSlotLoadingState, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="slotを読み込み中"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="MCPからこのWorkflowの編集可能な項目を取得しています。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,6,0,10" />
                                <ProgressBar Height="6"
                                             IsIndeterminate="True" />
                            </StackPanel>
                        </Border>

                        <Border Background="#281B25"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowSlotErrorState, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="slotの読み込みに失敗しました"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SlotLoadError}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,12" />
                                <Button Content="RETRY"
                                        Click="RetryWorkflow_Click"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowNoSlotState, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="編集可能なslotはありません"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="このWorkflowは低レベル設定なしで実行できます。必要ならVALIDATEで実行前チェックを行ってください。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding ShowReadyState, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="14"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="主要な生成設定"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="制作ごとに確認するPrompt・長さ・構図・Seedをここに集約しています。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="#162E3A"
                                                CornerRadius="8"
                                                Padding="9,5"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding PrimarySlots.Count, StringFormat={}{0}項目}"
                                                       Foreground="{StaticResource AccentStrongBrush}"
                                                       FontSize="10" />
                                        </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PrimarySlots}"
                                                  ItemTemplate="{StaticResource SlotEditorTemplate}"
                                                  Margin="0,12,0,0" />
                                    <Border Background="#0E1725"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,4,0,0"
                                            Visibility="{Binding HasPrimarySlots, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="主要設定として分類できる項目はありません。下の調整・詳細設定を確認してください。"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="14"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding HasTuningSlots, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="調整"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Steps・Denoise・Guidanceなど、仕上がりを微調整する項目です。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10" />
                                    <ItemsControl ItemsSource="{Binding TuningSlots}"
                                                  ItemTemplate="{StaticResource SlotEditorTemplate}" />
                                </StackPanel>
                            </Border>

                            <Expander Margin="0,12,0,0"
                                      Background="{StaticResource PanelBrush}"
                                      BorderBrush="{StaticResource LineBrush}"
                                      BorderThickness="1"
                                      IsExpanded="False"
                                      Visibility="{Binding HasAdvancedSlots, Converter={StaticResource BoolToVisibility}}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="詳細設定 / ADVANCED"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Sampler・Scheduler・VAE・Codecなど、必要なときだけ開きます。"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AdvancedSlots.Count, StringFormat={}{0}項目}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>
                                <Border Background="#0A101C"
                                        Padding="12"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{Binding AdvancedSlots}"
                                                  ItemTemplate="{StaticResource SlotEditorTemplate}" />
                                </Border>
                            </Expander>
                        </StackPanel>

                        <Border Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="14"
                                Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="バックアップ / 復元"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="直近3世代を保持。復元前に現在状態を保存します。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ComboBox x:Name="BackupCombo"
                                              ItemsSource="{Binding Backups}"
                                              Width="168"
                                              Margin="0,0,6,0" />
                                    <Button Content="RESTORE"
                                            ToolTip="選択した世代を復元"
                                            Click="Restore_Click"
                                            Margin="0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="14"
                                Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="最新の結果"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="生成した画像・動画をここで確認し、必要なものをChatGPTへ返します。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="出力フォルダ"
                                        Tag="{Binding OutputRoot}"
                                        ToolTip="ComfyUIのoutputフォルダを開く"
                                        Click="OpenOutputFolder_Click"
                                        VerticalAlignment="Top"
                                        Margin="0" />
                            </Grid>
                        </Border>
                        <Border Background="#0B1220"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasLatestOutputs, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding LatestOutputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Type}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="10" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="OPEN"
                                                        Tag="{Binding FullPath}"
                                                        ToolTip="OSの既定アプリで開く"
                                                        Click="OpenOutput_Click"
                                                        Padding="8,5"
                                                        Margin="6,0,0,0" />
                                            </Grid>
                                            <Image Source="{Binding FullPath}"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                                   MaxHeight="230"
                                                   Stretch="Uniform"
                                                   Margin="0,10,0,0"
                                                   ImageFailed="OutputImageFailed" />
                                            <MediaElement Source="{Binding FullPath}"
                                                          Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                                          LoadedBehavior="Play"
                                                          UnloadedBehavior="Stop"
                                                          MaxHeight="230"
                                                          Stretch="Uniform"
                                                          Margin="0,10,0,0"
                                                          MediaFailed="OutputMediaFailed" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border Background="#0B1220"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasLatestOutputs, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="まだ出力はありません。GENERATEで最初の1件を制作すると、ここにプレビューが表示されます。"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="14"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="制作セッション"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding SessionTitle, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="19"
                                         FontWeight="SemiBold"
                                         Margin="0,5,0,7" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#162A3A"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,5"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SessionStatusText}"
                                           Foreground="{StaticResource AccentStrongBrush}"
                                           FontSize="10" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SessionProgressText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button Content="新規セッション"
                                        Click="NewSession_Click"
                                        Padding="9,6" />
                                <Button Content="RESUME"
                                        ToolTip="完了・停止したセッションを再開"
                                        Click="Resume_Click"
                                        Padding="9,6"
                                        Margin="0" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="制作の前提"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" />
                                <Label Content="プロジェクト / チャット（ローカル表示名）"
                                       Margin="0,10,0,0" />
                                <TextBox Text="{Binding ProjectLabel, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="プロジェクトの表示名（任意）"
                                         Margin="0,4,0,5" />
                                <TextBox Text="{Binding ChatLabel, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="チャットの表示名（任意）"
                                         Margin="0,0,0,2" />
                                <Label Content="制作アイデア"
                                       Margin="0,8,0,0" />
                                <TextBox Text="{Binding Idea, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="120"
                                         ToolTip="ChatGPTへ伝える制作意図"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#102C31"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="CHATGPT HANDOFF"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentStrongBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Bootstrapで現在の制作状態を渡し、返ってきたCommandを反映します。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <Button Content="BOOTSTRAPをChatGPTへコピー"
                                        ToolTip="現在のWorkflow・主要設定・slot情報をコピー"
                                        Click="CopyBootstrap_Click"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="#071117"
                                        FontWeight="SemiBold"
                                        Margin="0" />
                                <TextBlock Text="画像・動画は生成後に必要なものだけ手動添付します。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,12" />
                                <Label Content="ChatGPTからのコマンド" />
                                <TextBlock Text="貼り付け → IMPORT / VALIDATE → APPLY"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Margin="0,3,0,4" />
                                <TextBox x:Name="CommandBox"
                                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="132"
                                         FontFamily="Cascadia Mono"
                                         FontSize="11"
                                         ToolTip="comfy-connector/1 commandを貼り付け" />
                                <WrapPanel Margin="0,7,0,0">
                                    <Button Content="IMPORT / VALIDATE"
                                            ToolTip="Commandの形式とslotを検証"
                                            Click="ImportCommand_Click" />
                                    <Button Content="APPLY"
                                            ToolTip="検証済みCommandをslotへ反映"
                                            Click="ApplyCommand_Click" />
                                    <Button Content="APPLY + GENERATE"
                                            ToolTip="反映後に1件のJobを生成"
                                            Click="ApplyGenerateCommand_Click"
                                            Margin="0" />
                                </WrapPanel>
                                <Button Content="RESULTをChatGPTへコピー"
                                        ToolTip="生成結果と出力パスをコピー"
                                        Click="CopyResult_Click"
                                        Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="反復履歴"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="制作の変化を追跡"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SessionProgressText}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <ListBox ItemsSource="{Binding Iterations}"
                                         ItemTemplate="{StaticResource IterationTemplate}"
                                         Margin="0,10,0,0"
                                         Visibility="{Binding HasIterations, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="まだ反復履歴はありません。GENERATEするとここに記録されます。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Visibility="{Binding HasIterations, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="最新の出力"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="ChatGPTへ返す素材を選択"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="フォルダ"
                                            Tag="{Binding OutputRoot}"
                                            ToolTip="ComfyUIのoutputフォルダを開く"
                                            Click="OpenOutputFolder_Click"
                                            Padding="7,5"
                                            Margin="0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding LatestOutputs}"
                                              Margin="0,10,0,0"
                                              Visibility="{Binding HasLatestOutputs, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Type}"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="OPEN"
                                                            Tag="{Binding FullPath}"
                                                            ToolTip="OSの既定アプリで開く"
                                                            Click="OpenOutput_Click"
                                                            Padding="7,5"
                                                            Margin="6,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="まだ出力はありません。中央のGENERATEから制作を開始してください。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Visibility="{Binding HasLatestOutputs, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="JOB"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding JobStatusText}"
                           Foreground="{StaticResource WarmBrush}"
                           VerticalAlignment="Center"
                           Margin="6,0,12,0" />
                <ProgressBar Width="90"
                             Height="6"
                             IsIndeterminate="{Binding IsJobActive}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                <Button Content="CANCEL JOB"
                        ToolTip="ConnectorのJob監視を停止し、ComfyUI側へcancelを要求"
                        Click="CancelJob_Click"
                        Padding="8,4"
                        Margin="0" />
            </StackPanel>
        </Grid>

        <Border Grid.RowSpan="3"
                Background="#DE070B14"
                Visibility="{Binding IsSetupVisible, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="20">
            <Border Width="660"
                    MaxHeight="780"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="初回設定 / 接続設定"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="ローカルの制作環境を接続"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,5" />
                        <TextBlock Text="ComfyUIとcomfy-mcpの場所を指定します。ConnectorはComfyUIを自動終了しません。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,20"
                                   TextWrapping="Wrap" />
                        <Label Content="ComfyUI Portableの場所" />
                        <TextBox Text="{Binding Settings.PortableRoot, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" />
                        <Label Content="comfy-mcpの実行ファイル" />
                        <TextBox Text="{Binding Settings.ComfyMcpPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" />
                        <Label Content="接続先Endpoint" />
                        <TextBox Text="{Binding Settings.Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" />
                        <Label Content="最大反復回数" />
                        <TextBox Text="{Binding Settings.MaximumIterations, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,20" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="設定を保存"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="#071117"
                                    FontWeight="SemiBold"
                                    Click="SaveSetup_Click" />
                            <Button Content="ログフォルダを開く"
                                    Click="OpenLogs_Click"
                                    Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>
