<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ChatGPTComfyConnector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ChatGPT Comfy Connector"
        Width="1680"
        Height="1040"
        MinWidth="1180"
        MinHeight="760"
        Language="ja-JP"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="SlotEditorTemplate">
            <Border x:Name="SlotChrome"
                    Background="{StaticResource PanelSoftBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="176" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PriorityLabel}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Address}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Address}" />
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Margin="14,0,14,0">
                        <TextBox x:Name="ValueEditor"
                                 Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Workflow slotの値。変更は保存前に確認できます。" />
                        <ComboBox x:Name="ChoiceEditor"
                                  ItemsSource="{Binding Choices}"
                                  Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Visibility="Collapsed"
                                  ToolTip="候補から選択、または値を入力" />
                    </Grid>
                    <StackPanel Grid.Column="2"
                                Width="70"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Type}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="要確認"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   Visibility="{Binding PairingSuspect, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasChoices}" Value="True">
                    <Setter TargetName="ValueEditor" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ChoiceEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PairingSuspect}" Value="True">
                    <Setter TargetName="SlotChrome" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PipelineStageTemplate">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Label}">
                <StackPanel Width="88"
                            HorizontalAlignment="Center">
                    <Grid Width="28"
                          Height="28"
                          HorizontalAlignment="Center">
                        <Ellipse Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                 Opacity="0.9" />
                        <TextBlock Text="{Binding Number}"
                                   Foreground="#071117"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding Key}"
                               Foreground="{Binding State, Converter={StaticResource StateToBrush}}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />
                    <TextBlock Text="{Binding StateLabel}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border Width="68"
                        Height="2"
                        Background="{Binding State, Converter={StaticResource StateToBrush}}"
                        Opacity="0.72"
                        VerticalAlignment="Top"
                        Margin="0,13,0,0"
                        Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HistoryIterationTemplate">
            <Border Width="238"
                    MinHeight="164"
                    Background="{StaticResource PanelSoftBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="11"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{Binding Number, StringFormat=ITERATION {0}}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Status}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="1"
                            Background="#0A101C"
                            CornerRadius="7"
                            Margin="0,8,0,8"
                            MinHeight="74">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Outputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="214"
                                              Height="74">
                                            <Image Source="{Binding FullPath}"
                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                                   Stretch="UniformToFill"
                                                   Opacity="0.9"
                                                   ImageFailed="OutputImageFailed" />
                                            <MediaElement Source="{Binding FullPath}"
                                                          Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                                          LoadedBehavior="Play"
                                                          UnloadedBehavior="Stop"
                                                          Stretch="UniformToFill"
                                                          Opacity="0.9"
                                                          MediaFailed="OutputMediaFailed" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="出力なし"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasOutputs, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2"
                               Text="{Binding Prompt}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Prompt}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PreviewOutputTemplate">
            <Border Width="520"
                    Height="324"
                    Background="#080E19"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,12,0">
                <Grid>
                    <Image Source="{Binding FullPath}"
                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                           Stretch="Uniform"
                           Margin="8"
                           ImageFailed="OutputImageFailed" />
                    <MediaElement Source="{Binding FullPath}"
                                  Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                  LoadedBehavior="Play"
                                  UnloadedBehavior="Stop"
                                  Stretch="Uniform"
                                  Margin="8"
                                  MediaFailed="OutputMediaFailed" />
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PREVIEW UNAVAILABLE"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="OPENで既定アプリから確認できます"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <Border VerticalAlignment="Bottom"
                            Background="#D8070A12"
                            Padding="10,8">
                        <Grid>
                            <TextBlock Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,64,0" />
                            <Button Content="OPEN"
                                    Tag="{Binding FullPath}"
                                    Click="OpenOutput_Click"
                                    Padding="8,4"
                                    HorizontalAlignment="Right"
                                    Margin="0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="15"
                Padding="14,11"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="COMFY / CHATGPT"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Connector"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#0A111D"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6"
                        Margin="10,0,14,0"
                        AutomationProperties.Name="SYSTEM CONNECTION">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="SYSTEM CONNECTION"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SystemConnectionSummary}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="9"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"
                                       Margin="12,0,0,0" />
                        </Grid>
                        <Grid Grid.Row="1"
                              Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        AutomationProperties.Name="Connector">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding ConnectorSystemState, Converter={StaticResource StateToBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock Text="Connector"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ConnectorSystemState}"
                                               Foreground="{Binding ConnectorSystemState, Converter={StaticResource StateToBrush}}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Height="1"
                                    Margin="9,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource LineStrongBrush}"
                                    Opacity="0.55" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        AutomationProperties.Name="MCP">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding McpSystemState, Converter={StaticResource StateToBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock Text="MCP"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding McpSystemState}"
                                               Foreground="{Binding McpSystemState, Converter={StaticResource StateToBrush}}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="3"
                                    Height="1"
                                    Margin="9,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource LineStrongBrush}"
                                    Opacity="0.55" />
                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        AutomationProperties.Name="ComfyUI">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding ComfyUiSystemState, Converter={StaticResource StateToBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock Text="ComfyUI"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ComfyUiSystemState}"
                                               Foreground="{Binding ComfyUiSystemState, Converter={StaticResource StateToBrush}}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="5"
                                    Height="1"
                                    Margin="9,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource LineStrongBrush}"
                                    Opacity="0.55" />
                            <StackPanel Grid.Column="6"
                                        Orientation="Horizontal"
                                        AutomationProperties.Name="GPU">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{Binding GpuSystemState, Converter={StaticResource StateToBrush}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <StackPanel>
                                    <TextBlock Text="GPU"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GpuSystemState}"
                                               Foreground="{Binding GpuSystemState, Converter={StaticResource StateToBrush}}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding SelectedWorkflowText}"
                                   Foreground="{StaticResource WarmBrush}"
                                   FontSize="9"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Right"
                                   Margin="0,5,0,0" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="SETUP"
                            ToolTip="接続先とPortableパスを設定"
                            Click="Setup_Click" />
                    <Button Content="CONNECT"
                            ToolTip="comfy-mcpへ接続"
                            Click="Connect_Click" />
                    <Button Content="START COMFYUI"
                            ToolTip="ComfyUIを起動（Connectorは終了させません）"
                            Click="StartComfy_Click"
                            Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,14,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="13"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,10">
                        <TextBlock Text="WORKFLOW"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="制作に使うWorkflow"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="REFRESH"
                                    ToolTip="Workflow一覧を再読み込み"
                                    Click="Refresh_Click" />
                            <Button Grid.Column="1"
                                    Content="フォルダ"
                                    ToolTip="Workflowフォルダを開く"
                                    Click="OpenWorkflowFolder_Click"
                                    Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="#0A101C"
                            CornerRadius="10"
                            Padding="7"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TreeView ItemsSource="{Binding TreeNodes}"
                                          SelectedItemChanged="WorkflowTree_SelectedItemChanged">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="2,3"
                                                       TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.Name="{Binding Name}"
                                                       ToolTip="{Binding RelativePath}" />
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasTreeNodes, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="Workflowがありません"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="SetupのパスとREFRESHを確認してください"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextAlignment="Center"
                                           Margin="8,5,8,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2"
                            Background="{StaticResource PanelSoftBrush}"
                            CornerRadius="10"
                            Padding="11"
                            Margin="0,11,0,0"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="選択中のWorkflow"
                                       FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedWorkflowText}"
                                       Foreground="{StaticResource WarmBrush}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="36"
                                       Margin="0,4,0,3" />
                            <TextBlock Text="{Binding WorkflowSlotSummaryText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,9" />
                            <Button Content="設定を編集"
                                    ToolTip="主要設定・詳細設定・Backup / Restoreを開く"
                                    Click="OpenWorkflowEditor_Click"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="#071117"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,8" />
                            <TextBox x:Name="WorkflowNameBox"
                                     ToolTip="拡張子を除いた新しいWorkflow名"
                                     Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="複製"
                                        ToolTip="選択中Workflowを複製"
                                        Click="Duplicate_Click" />
                                <Button Grid.Column="1"
                                        Content="名前変更"
                                        ToolTip="選択中Workflowの名前を変更"
                                        Click="Rename_Click"
                                        Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="16"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Background="#0D1725"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="13"
                                AutomationProperties.Name="CREATION PIPELINE">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CREATION PIPELINE"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="制作を進める一本のライン"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentIterationLabel}"
                                                   Foreground="{StaticResource WarmBrush}"
                                                   FontSize="10"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding PipelineLoopText}"
                                                   Foreground="{Binding CurrentCreationStageState, Converter={StaticResource StateToBrush}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="0,13,0,0">
                                    <ItemsControl ItemsSource="{Binding PipelineStages}"
                                                  ItemTemplate="{StaticResource PipelineStageTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{Binding CurrentCreationStageState, Converter={StaticResource StateToBrush}}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CurrentCreationStageText}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CurrentCreationStageDescription}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#101C2C"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="15"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CREATION IDEA"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="作りたいイメージ"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,4" />
                                    <TextBlock Text="ここからChatGPTと制作意図を磨き、Commandへつなぎます。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />
                                    <TextBox Text="{Binding Idea, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="94"
                                             AutomationProperties.Name="制作アイデア入力"
                                             ToolTip="作りたい映像のイメージ・雰囲気・目的を入力" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Margin="12,0,0,0">
                                    <Button Content="SEND TO CHATGPT"
                                            Click="CopyIdea_Click"
                                            ToolTip="制作アイデアをクリップボードへコピー"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="#071117"
                                            FontWeight="SemiBold"
                                            Margin="0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CREATION CANVAS"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="最新生成物 / Video Preview"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding SelectedWorkflowText}"
                                                   Foreground="{StaticResource WarmBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#162A3A"
                                            BorderBrush="{Binding CurrentCreationStageState, Converter={StaticResource StateToBrush}}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9,6"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="{Binding JobStatusText}"
                                                       Foreground="{Binding CurrentCreationStageState, Converter={StaticResource StateToBrush}}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding JobStatusDetailText}"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="9"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Background="#080E19"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        MinHeight="324"
                                        Margin="0,12,0,0">
                                    <Grid>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      Visibility="{Binding HasLatestOutputs, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding LatestOutputs}"
                                                          ItemTemplate="{StaticResource PreviewOutputTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasLatestOutputs, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="VIDEO PREVIEW"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="まだ生成結果はありません"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,7,0,0" />
                                            <TextBlock Text="GENERATEすると、ここに画像・動画を表示します"
                                                       Foreground="{StaticResource LineStrongBrush}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <ProgressBar Width="130"
                                                     Height="7"
                                                     IsIndeterminate="{Binding IsJobActive}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding JobStatusDetailText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right">
                                        <Button Content="GENERATE"
                                                ToolTip="validate後に1件のJobを生成"
                                                Background="{StaticResource WarmBrush}"
                                                Foreground="#21151A"
                                                FontWeight="SemiBold"
                                                Click="Generate_Click"
                                                IsEnabled="{Binding CanRunWorkflow}" />
                                        <Button Content="CANCEL"
                                                ToolTip="実行中のJobへcancelを要求"
                                                Click="CancelJob_Click"
                                                IsEnabled="{Binding IsJobActive}"
                                                Margin="0" />
                                    </WrapPanel>
                                </Grid>
                                <Border Background="#261C25"
                                        BorderBrush="{StaticResource WarningBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="9"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding ShowDisconnectedState, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="MCP未接続です。CONNECT後にslotを取得するとGENERATEを有効化できます。"
                                               Foreground="{StaticResource WarningBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GENERATION HISTORY"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Iterationごとの生成結果を比較"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SessionProgressText}"
                                               Foreground="{StaticResource WarmBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="0,11,0,0"
                                              Visibility="{Binding HasIterations, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Iterations}"
                                                  ItemTemplate="{StaticResource HistoryIterationTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border Background="#0A101C"
                                        CornerRadius="8"
                                        Padding="11"
                                        Margin="0,11,0,0"
                                        Visibility="{Binding HasIterations, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="まだGeneration Historyはありません。最初のGENERATEがIteration #1になります。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="14"
                    Padding="14"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CHATGPT / SESSION"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding SessionTitle, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="19"
                                         FontWeight="SemiBold"
                                         Margin="0,5,0,7" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#162A3A"
                                    BorderBrush="{Binding CurrentCreationStageState, Converter={StaticResource StateToBrush}}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,5"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SessionStatusText}"
                                           Foreground="{Binding CurrentCreationStageState, Converter={StaticResource StateToBrush}}"
                                           FontSize="10" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SessionProgressText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <Button Content="新規セッション"
                                        Click="NewSession_Click"
                                        Padding="9,6" />
                                <Button Content="RESUME"
                                        ToolTip="完了・停止したセッションを再開"
                                        Click="Resume_Click"
                                        Padding="9,6"
                                        Margin="0" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource PanelSoftBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="SESSION CONTEXT"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" />
                                <Label Content="プロジェクト / チャット（ローカル表示名）"
                                       Margin="0,10,0,0" />
                                <TextBox Text="{Binding ProjectLabel, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="プロジェクトの表示名（任意）"
                                         Margin="0,4,0,5" />
                                <TextBox Text="{Binding ChatLabel, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="チャットの表示名（任意）"
                                         Margin="0,0,0,2" />
                                <TextBlock Text="ChatGPTとの制作連携をここで管理します。アイデアと生成物は中央キャンバスに集約しています。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#102C31"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="CHATGPT HANDOFF"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentStrongBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Bootstrapで現在の制作状態を渡し、返ってきたCommandを反映します。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <Button Content="BOOTSTRAPをChatGPTへコピー"
                                        ToolTip="現在のWorkflow・主要設定・slot情報をコピー"
                                        Click="CopyBootstrap_Click"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="#071117"
                                        FontWeight="SemiBold"
                                        Margin="0" />
                                <TextBlock Text="生成後はRESULT Contextを返し、画像・動画を必要なものだけ手動添付します。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,12" />
                                <Label Content="ChatGPTからのCommand" />
                                <TextBlock Text="貼り付け → IMPORT / VALIDATE → APPLY"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Margin="0,3,0,4" />
                                <TextBox x:Name="CommandBox"
                                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="148"
                                         FontFamily="Cascadia Mono"
                                         FontSize="11"
                                         ToolTip="comfy-connector/1 commandを貼り付け" />
                                <WrapPanel Margin="0,7,0,0">
                                    <Button Content="IMPORT / VALIDATE"
                                            ToolTip="Commandの形式とslotを検証"
                                            Click="ImportCommand_Click" />
                                    <Button Content="APPLY"
                                            ToolTip="検証済みCommandをslotへ反映"
                                            Click="ApplyCommand_Click" />
                                    <Button Content="APPLY + GENERATE"
                                            ToolTip="反映後に1件のJobを生成"
                                            Click="ApplyGenerateCommand_Click"
                                            Margin="0" />
                                </WrapPanel>
                                <Button Content="RESULTをChatGPTへコピー"
                                        ToolTip="生成結果と出力パスをコピー"
                                        Click="CopyResult_Click"
                                        Margin="0,10,0,0" />
                                <TextBlock Text="COMPLETEはcomplete commandで実行します。完了後もRESUMEで再開できます。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="SYSTEM"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ConnectionStateText}"
                           Foreground="{Binding ConnectionStateText, Converter={StaticResource StateToBrush}}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.RowSpan="3"
                Background="#B6070A12"
                Visibility="{Binding IsWorkflowEditorVisible, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="15">
            <Border Width="640"
                    MaxHeight="900"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="WORKFLOW SETTINGS"
                                       FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="確認・微調整・詳細編集"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="制作キャンバスを占有しないWorkflow編集ビュー"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="閉じる"
                                Click="CloseWorkflowEditor_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,14,0,14">
                        <StackPanel>
                            <Border Background="{StaticResource PanelSoftBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedWorkflowName}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding WorkflowSlotSummaryText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1">
                                        <Button Content="SAVE"
                                                ToolTip="変更を保存してWorkflowをvalidate"
                                                Click="Save_Click"
                                                IsEnabled="{Binding CanRunWorkflow}" />
                                        <Button Content="VALIDATE"
                                                ToolTip="現在のWorkflowをvalidate"
                                                Click="Validate_Click"
                                                IsEnabled="{Binding CanRunWorkflow}"
                                                Margin="0" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Background="#261C25"
                                    BorderBrush="{StaticResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,11,0,0"
                                    Visibility="{Binding ShowDisconnectedState, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="MCP未接続"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="slotを編集するにはCONNECTが必要です。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelSoftBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,11,0,0"
                                    Visibility="{Binding ShowSlotLoadingState, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="slotを読み込み中"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="MCPから編集可能な項目を取得しています。"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Margin="0,5,0,9" />
                                    <ProgressBar Height="6"
                                                 IsIndeterminate="True" />
                                </StackPanel>
                            </Border>
                            <Border Background="#281B25"
                                    BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,11,0,0"
                                    Visibility="{Binding ShowSlotErrorState, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="slotの読み込みに失敗しました"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SlotLoadError}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,9" />
                                    <Button Content="RETRY"
                                            Click="RetryWorkflow_Click"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelSoftBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,11,0,0"
                                    Visibility="{Binding ShowNoSlotState, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="編集可能なslotはありません。必要ならVALIDATEで実行前チェックを行えます。"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="12"
                                    Margin="0,11,0,0"
                                    Visibility="{Binding ShowReadyState, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="基本設定"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Prompt・Duration・構図・Resolution・Seedなど、制作ごとに触る項目"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,10" />
                                    <ItemsControl ItemsSource="{Binding PrimarySlots}"
                                                  ItemTemplate="{StaticResource SlotEditorTemplate}" />
                                    <Border Background="#0E1725"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,3,0,0"
                                            Visibility="{Binding HasPrimarySlots, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="基本設定に分類できるslotはありません。詳細設定を確認してください。"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="12"
                                    Margin="0,11,0,0"
                                    Visibility="{Binding HasTuningSlots, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="調整"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Steps・Denoise・Guidanceなど、仕上がりを調整する項目"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Margin="0,4,0,10" />
                                    <ItemsControl ItemsSource="{Binding TuningSlots}"
                                                  ItemTemplate="{StaticResource SlotEditorTemplate}" />
                                </StackPanel>
                            </Border>
                            <Expander Margin="0,11,0,0"
                                      Background="{StaticResource PanelBrush}"
                                      BorderBrush="{StaticResource LineBrush}"
                                      BorderThickness="1"
                                      IsExpanded="False"
                                      Visibility="{Binding HasAdvancedSlots, Converter={StaticResource BoolToVisibility}}">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="詳細設定 / ADVANCED"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Sampler・Scheduler・VAE・Codec・Format・Filename Prefixなど"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <Border Background="#0A101C"
                                        Padding="10"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{Binding AdvancedSlots}"
                                                  ItemTemplate="{StaticResource SlotEditorTemplate}" />
                                </Border>
                            </Expander>

                            <Border Background="{StaticResource PanelSoftBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,11,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="BACKUP / RESTORE"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="直近3世代を保持。復元前に現在状態を保存します。"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <ComboBox x:Name="BackupCombo"
                                                  ItemsSource="{Binding Backups}"
                                                  Width="180"
                                                  Margin="0,0,6,0" />
                                        <Button Content="RESTORE"
                                                ToolTip="選択した世代を復元"
                                                Click="Restore_Click"
                                                Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="閉じる"
                                Click="CloseWorkflowEditor_Click"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#DE070B14"
                Visibility="{Binding IsSetupVisible, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="20">
            <Border Width="660"
                    MaxHeight="780"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="初回設定 / 接続設定"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="ローカルの制作環境を接続"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,5" />
                        <TextBlock Text="ComfyUIとcomfy-mcpの場所を指定します。ConnectorはComfyUIを自動終了しません。"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,20"
                                   TextWrapping="Wrap" />
                        <Label Content="ComfyUI Portableの場所" />
                        <TextBox Text="{Binding Settings.PortableRoot, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" />
                        <Label Content="comfy-mcpの実行ファイル" />
                        <TextBox Text="{Binding Settings.ComfyMcpPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" />
                        <Label Content="接続先Endpoint" />
                        <TextBox Text="{Binding Settings.Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,12" />
                        <Label Content="最大反復回数" />
                        <TextBox Text="{Binding Settings.MaximumIterations, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,20" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="設定を保存"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="#071117"
                                    FontWeight="SemiBold"
                                    Click="SaveSetup_Click" />
                            <Button Content="ログフォルダを開く"
                                    Click="OpenLogs_Click"
                                    Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>
